graph LR
    subgraph 开发阶段
        CODE["编写代码"]
        FMT["gofmt + goimports<br/>自动格式化"]
        LINT["golangci-lint<br/>代码检查"]
        TEST["go test<br/>单元测试"]
    end

    subgraph 提交阶段
        HOOK["Git Hooks<br/>lefthook"]
        VET["go vet<br/>静态分析"]
        SEC["gosec<br/>安全扫描"]
    end

    subgraph CI/CD
        PUSH["git push"]
        CI_LINT["CI: golangci-lint"]
        CI_TEST["CI: go test -race"]
        CI_BUILD["CI: go build"]
        CI_IMAGE["Docker Build"]
    end

    subgraph 发布阶段
        RELEASE["GoReleaser<br/>交叉编译"]
        BIN_LINUX["Linux amd64"]
        BIN_ARM["Linux arm64"]
        BIN_MAC["macOS arm64"]
        IMAGE["Docker Image<br/>推送到 Harbor"]
    end

    CODE --> FMT --> LINT --> TEST
    TEST --> HOOK
    HOOK --> VET
    HOOK --> SEC
    SEC --> PUSH
    PUSH --> CI_LINT --> CI_TEST --> CI_BUILD --> CI_IMAGE
    CI_IMAGE --> RELEASE
    RELEASE --> BIN_LINUX
    RELEASE --> BIN_ARM
    RELEASE --> BIN_MAC
    RELEASE --> IMAGE

